# Copy to `.env` and fill in real values. Never commit the real `.env`.

# --- General -------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
LOG_JSON=false

# --- Security --------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-32-plus-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# --- Database --------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_infra_failure_prediction

# --- Redis -------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Kafka (used from Module 3 onward) ----------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- MLflow (used from Module 6 onward) ---------------------------------------
MLFLOW_TRACKING_URI=http://localhost:5000

# --- CORS ----------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000"]
